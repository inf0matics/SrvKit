{
  "name": "srvkit",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs nuxt dev",
    "build": "nuxt build && node scripts/build-cli.mjs",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots/run.mjs",
    "db:seed": "node --env-file=.env scripts/seed-dev.ts",
    "dev:local": "npm run db:seed && nuxt dev --port 55385"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bip39": "^3.1.0",
    "chokidar": "^6.0.0",
    "croner": "^11.0.0",
    "h3": "^1.15.11",
    "tar": "^7.5.16"
  }
}
